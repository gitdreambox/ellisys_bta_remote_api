<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>Ellisys.Analysis.Automation</RootNamespace>
    <AssemblyName>Ellisys.Analysis.Automation</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Ellisys.Analysis.Automation.snk</AssemblyOriginatorKeyFile>

    <!-- NuGet package metadata -->
    <PackageId>Ellisys.Analysis.Automation</PackageId>
    <Version>0.1.0</Version>
    <Title>Ellisys Analysis Automation SDK</Title>
    <Description>Idiomatic C# client for the Ellisys analyzer Remote Control automation API (ZeroC Ice based).</Description>
    <Authors>Ellisys</Authors>
    <Company>Ellisys</Company>
    <Copyright>Copyright (c) Ellisys</Copyright>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://www.ellisys.com</PackageProjectUrl>
    <PackageTags>ellisys;analyzer;remote-control;ice;bluetooth;wifi;wpan;usb;automation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- The Generated/ Ice bindings are slice2cs output; don't fail or warn on them. -->
    <NoWarn>$(NoWarn);CS1591;CS0809</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="zeroc.ice.net" Version="3.7.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ellisys.Analysis.Automation.Tests" Key="" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dense single-file usage guide for AI agents; shipped in the package. -->
    <None Include="llms.txt" Pack="true" PackagePath="" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
